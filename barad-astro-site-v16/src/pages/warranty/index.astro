---
import LegalPage from '../../components/LegalPage.astro';
import { siteConfig } from '../../data/siteData';
import { packageWarrantyDays } from '../../data/content';
const d = siteConfig.warrantyDays;
---
<LegalPage
  title="سياسة الضمان والصيانة"
  description={`ضمان ${d} يوماً على أعمال الغسيل والصيانة والإصلاح وشحن الفريون والتركيب والتأسيس من مؤسسة براد لصيانة التكييف في جدة، وهو ضمان على العمل فقط.`}
  path="/warranty/"
  updated="21 نوفمبر 2026"
>
  <section>
    <h2>مدة الضمان</h2>
    <p>نضمن العمل الذي ننفذه لمدة <strong class="text-ink">{d} يوماً</strong> من تاريخ إتمام الخدمة، وذلك لجميع خدماتنا للأفراد: الغسيل والتنظيف، والصيانة والإصلاح، وشحن الفريون، والتركيب والتأسيس.</p>
    <p class="mt-2">إن ظهر خلال المدة خلل في نفس العمل المنفذ بسبب أدائنا، فنعالجه دون أجرة عمل إضافية.</p>
  </section>

  <section>
    <h2>الضمان على العمل فقط، وليس على القطع</h2>
    <p>هذا الضمان يغطي <strong class="text-ink">العمل (التنفيذ)</strong> فقط. أما <strong class="text-ink">قطع الغيار والأجهزة</strong> فلا يشملها ضماننا، ويسري عليها ضمان المحل الذي اشتُريت منه أو ضمان الشركة المصنِّعة، حسب شروطه.</p>
  </section>

  <section>
    <h2>ما الذي يشمله الضمان</h2>
    <ul>
      <li>إعادة معالجة نفس العطل الذي أُصلح إذا عاد خلال مدة الضمان.</li>
      <li>تسرب أو تنقيط ماء ظهر من نفس الوصلة أو التمديد أو التركيب الذي نفذناه.</li>
      <li>تقصير في الغسيل أو الصيانة الوقائية يظهر أثره خلال المدة، بعد معاينتنا له.</li>
      <li>خلل في التركيب أو التوصيل أو التثبيت الذي نفذناه.</li>
    </ul>
  </section>

  <section>
    <h2>ما الذي لا يشمله الضمان</h2>
    <ul>
      <li>الأعطال الجديدة غير المرتبطة بالعمل الذي نفذناه، أو في أجزاء لم نعمل عليها.</li>
      <li>سوء الاستخدام، أو الكسر والضرر الخارجي، أو تدخل شخص آخر في المكيف أو في عملنا بعد خروجنا.</li>
      <li>أعطال سببها الكهرباء (انقطاع، تذبذب، ضعف التيار أو سوء التمديدات الأصلية).</li>
      <li>التآكل والاستهلاك الطبيعي، أو قِدم الأجزاء التي لم تُستبدل.</li>
      <li>الأعمال التي رفض العميل توصيتنا بها أو طلب تنفيذها بخلاف نصيحتنا.</li>
      <li>قطع الغيار والأجهزة نفسها: ضمانها من المحل الذي اشتُريت منه أو من الشركة المصنِّعة.</li>
    </ul>
  </section>

  <section>
    <h2>كيف تطالب بالضمان</h2>
    <ul>
      <li>تواصل معنا داخل مدة الضمان هاتفياً أو عبر واتساب على {siteConfig.phoneDisplay}.</li>
      <li>اذكر تاريخ الخدمة وعنوانك ووصف المشكلة (ويفضل صورة أو فيديو قصير).</li>
      <li>يُعدّ إثباتاً للخدمة: الفاتورة أو أي رسالة واتساب بيننا تثبت التنفيذ والتاريخ.</li>
      <li>نحدد لك موعد معاينة في أقرب وقت ممكن ضمن ساعات العمل: {siteConfig.hoursText}.</li>
      <li>إن تبيّن أن الخلل خارج نطاق الضمان، فنخبرك بالسبب، ونعرض عليك الإصلاح باتفاق جديد.</li>
    </ul>
  </section>

  <section>
    <h2>أعضاء الباقة السنوية</h2>
    <p>يمتد ضمان الغسيل لأعضاء <a href="/loyalty/">الباقة السنوية</a> إلى <strong class="text-ink">{packageWarrantyDays} يوماً</strong>، وتسري عليه نفس الشروط أعلاه.</p>
  </section>

  <section>
    <h2>مشاريع الجهات والشركات والمؤسسات</h2>
    <p>تُحدَّد مدة الضمان وشروطه ونطاقه في العقد المكتوب لكل مشروع، وما يُكتب في العقد هو المعتمد.</p>
  </section>

  <section>
    <h2>عقود الصيانة السنوية</h2>
    <p>تُنظَّم زياراتها وما تشمله وشروطها في عقد الصيانة نفسه، ولا تُعدّ ضماناً على الأجهزة.</p>
  </section>

  <section>
    <h2>حقوقك النظامية</h2>
    <p>لا تقيّد هذه السياسة أي حقوق تقررها لك الأنظمة السعودية. انظر أيضاً <a href="/terms/">الشروط والأحكام</a>.</p>
  </section>
</LegalPage>
