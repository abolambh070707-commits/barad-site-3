---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButtons from '../components/CtaButtons.astro';
import { galleryItems } from '../data/siteData';
---
<BaseLayout
  title="معرض أعمال مؤسسة براد لصيانة التكييف في جدة"
  description="معرض صور لخدمات مؤسسة براد في غسيل وصيانة وتأسيس المكيفات في جدة."
  canonicalPath="/gallery/"
  crumbs={[{ name: 'معرض الأعمال' }]}
>
  <section class="py-8 px-4 max-w-7xl mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">معرض الأعمال</h1>
    <p class="text-sm text-muted mb-6">اضغط على أي صورة لتكبيرها.</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      {galleryItems.map((g) => (
        <button type="button" data-gallery-item data-full-src={`${g.imageBase}.webp`} data-caption={`${g.title} — ${g.caption}`} class="group text-right rounded-2xl overflow-hidden bg-card border border-line hover:border-brand hover:shadow-lg transition">
          <picture>
            <source type="image/avif" srcset={`${g.imageBase}-400w.avif 400w, ${g.imageBase}.avif 800w`} sizes="(max-width: 640px) 50vw, 280px" />
            <source type="image/webp" srcset={`${g.imageBase}-400w.webp 400w, ${g.imageBase}.webp 800w`} sizes="(max-width: 640px) 50vw, 280px" />
            <img src={`${g.imageBase}-400w.webp`} alt={`${g.title} — ${g.caption}`} width={g.width} height={g.height} loading="lazy" decoding="async" class="w-full h-32 sm:h-44 object-cover" />
          </picture>
          <div class="p-3">
            <p class="font-bold text-ink text-xs sm:text-sm">{g.title}</p>
            <p class="text-xs text-muted mt-1 line-clamp-2">{g.caption}</p>
          </div>
        </button>
      ))}
    </div>
    <div class="mt-10 max-w-md mx-auto text-center space-y-3">
      <p class="font-extrabold text-ink">تحتاج خدمة مشابهة؟</p>
      <CtaButtons loc="gallery" />
    </div>
  </section>
</BaseLayout>
