---
export interface BreadcrumbLink {
  name: string;
  href?: string;
}
export interface Props {
  items: BreadcrumbLink[];
}
const { items } = Astro.props;
---
<nav aria-label="مسار التنقل" class="bg-card border-b border-line py-2.5 px-4">
  <div class="max-w-7xl mx-auto">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
      {items.map((item, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {!isLast && item.href ? (
              <>
                <a href={item.href} class="hover:text-brand underline underline-offset-4 transition-colors">{item.name}</a>
                <span aria-hidden="true">/</span>
              </>
            ) : (
              <span class="font-bold text-ink" aria-current="page">{item.name}</span>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</nav>
