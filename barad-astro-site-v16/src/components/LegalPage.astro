---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteData';

export interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
---
<BaseLayout title={`${title} | ${siteConfig.shortName}`} description={description} canonicalPath={path} crumbs={[{ name: title }]}>
  <article class="py-8 px-4 max-w-3xl mx-auto">
    <h1 class="text-2xl sm:text-3xl font-extrabold mb-1">{title}</h1>
    <p class="text-xs text-muted mb-6">آخر تحديث: {updated}</p>
    <div class="space-y-6 text-sm sm:text-base leading-relaxed [&_h2]:text-lg [&_h2]:font-extrabold [&_h2]:text-ink [&_h2]:mb-2 [&_ul]:list-disc [&_ul]:pr-5 [&_ul]:space-y-1.5 [&_a]:text-brand [&_a]:underline">
      <slot />
    </div>
  </article>
</BaseLayout>
